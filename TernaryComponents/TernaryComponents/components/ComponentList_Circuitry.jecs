TernaryBuffer:
    column: "Logic"
    category: "Ternary"
    prefab:
        blocks:
            -
                mesh: BufferBody
        inputs:
            -
                position: (0, 1.15, -0.5)
                rotation: (-90, 0, 0)
                length: 0.5
        outputs:
            -
                position: (0, 0.4, 0.5)
                rotation: (90, 0, 0)
    logicCode: TernaryComponents.Server.Buffer
    placingRules: Standard

TernaryInverter:
    column: "Logic"
    category: "Ternary"
    prefab:
        blocks:
            - Standard
        inputs:
            -
                position: (0, 1, 0)
        outputs:
            -
                position: (0, 0.5, 0.5)
                rotation: (90, 0, 0)
                startOn: true
    logicCode: TernaryComponents.Server.Inverter
    placingRules:
        gridPlacingDimensions: (1, 2)
        
TernaryMaxGate:
    column: "Logic"
    category: "Ternary"
    logicCode: TernaryComponents.Server.MaxGate
    prefabGenerator: LogicWorld.ClientCode.DynamicGenerators.AndGatePrefabGenerator
    placingRulesGenerator: LogicWorld.ClientCode.DynamicGenerators.AndGatePlacingRulesGenerator
    
TernaryMinGate:
    column: "Logic"
    category: "Ternary"
    logicCode: TernaryComponents.Server.MinGate
    prefabGenerator: LogicWorld.ClientCode.DynamicGenerators.AndGatePrefabGenerator
    placingRulesGenerator: LogicWorld.ClientCode.DynamicGenerators.AndGatePlacingRulesGenerator
    
TernaryConGate:
    column: "Logic"
    category: "Ternary"
    logicCode: TernaryComponents.Server.ConGate
    prefabGenerator: LogicWorld.ClientCode.DynamicGenerators.AndGatePrefabGenerator
    placingRulesGenerator: LogicWorld.ClientCode.DynamicGenerators.AndGatePlacingRulesGenerator
    
TernaryAnyGate:
    column: "Logic"
    category: "Ternary"
    logicCode: TernaryComponents.Server.AnyGate
    prefabGenerator: LogicWorld.ClientCode.DynamicGenerators.AndGatePrefabGenerator
    placingRulesGenerator: LogicWorld.ClientCode.DynamicGenerators.AndGatePlacingRulesGenerator

TernaryDefaulter:
    column: "Logic"
    category: "Ternary"
    prefab:
        blocks:
            -
                position: (0, 0, 0)
                scale: (1, 1, 1)
        inputs:
            -
                position: (0.5, 0.5, 0)
                rotation: (0, 0, -90)
                length: 0.62
            -
                position: (0, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.62
        outputs:
            -
                position: (0, 0.5, 0.5)
                rotation: (90, 0, 0)
    logicCode: TernaryComponents.Server.Defaulter
    placingRules: Standard
    
TernaryDLatch:
    column: "Logic"
    category: "Ternary"
    prefab:
        blocks:
            -
                color: 349F16
                position: (0, 0, 0.5)
                scale: (1, 1, 2)
        inputs:
            -
                position: (0, 1, 0)
            -
                position: (0, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.62
        outputs:
            -
                position: (0, 1, 1)
    logicCode: TernaryComponents.Server.DLatch
    placingRules:
        offsetDimensions: (1, 2)
        gridPlacingDimensions: (1, 3)
        allowFineRotation: false
    
TernaryDirectionalRelay:
    column: "Logic"
    category: "Ternary"
    prefab:
        blocks:
            -
                color: 7E133B
                position: (0, 0, 0.5)
                scale: (1, 1, 2)
        inputs:
            -
                position: (0, 1, 0.5)
            -
                position: (0, 0.5, -0.5)
                rotation: (-90, 1/6, 0)
                length: 0.62
            -
                position: (0, 0.5, 1.5)
                rotation: (90, -1/6, 0)
                length: 0.62
    logicCode: TernaryComponents.Server.DirectionalRelay
    placingRules:
        offsetDimensions: (1, 2)
        gridPlacingDimensions: (1, 4)
        allowFineRotation: false
