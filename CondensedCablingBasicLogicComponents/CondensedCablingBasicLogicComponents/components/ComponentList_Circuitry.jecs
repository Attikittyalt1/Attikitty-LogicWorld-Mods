SuperInverter:
    column: "Logic"
    category: "SuperLogic"
    prefab:
        blocks:
            - Standard
        inputs:
            -
                position: (0, 1, 0)
        outputs:
            -
                position: (0, 0.5, 0.5)
                rotation: (90, 0, 0)
                startOn: true
    logicCode: CondensedCablingBasicLogicComponents.Server.SuperInverter
    clientCode: CondensedCablingBasicLogicComponents.Client.GenericSingleSliderSuperGate
    placingRules:
        gridPlacingDimensions: (1, 2)

SuperXorGate:
    column: "Logic"
    category: "SuperLogic"
    prefab:
        blocks:
            -
                scale: (2, 1, 1)
                position: (0.5, 0, 0)
                color: 1D2f8E
        inputs:
            -
                position: (0, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.62
            -
                position: (1, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.62
        outputs:
            -
                position: (1, 0.5, 0.5)
                rotation: (90, 0, 0)
    logicCode: CondensedCablingBasicLogicComponents.Server.SuperXorGate
    clientCode: CondensedCablingBasicLogicComponents.Client.GenericSingleSliderSuperGate
    placingRules:
        offsetDimensions: (2, 1)
        gridPlacingDimensions: (2, 2)
        allowFineRotation: false
        canBeFlipped: true
        flippingPointHeight: 0.5

SuperAndGate:
    column: "Logic"
    category: "SuperLogic"
    logicCode: CondensedCablingBasicLogicComponents.Server.SuperAndGate
    clientCode: CondensedCablingBasicLogicComponents.Client.GenericSingleSliderSuperGate
    prefabGenerator: LogicWorld.ClientCode.DynamicGenerators.AndGatePrefabGenerator
    placingRulesGenerator: LogicWorld.ClientCode.DynamicGenerators.AndGatePlacingRulesGenerator

SuperDLatch:
    column: "Logic"
    category: "SuperLogic"
    prefab:
        blocks:
            -
                color: 349F16
                position: (0, 0, 0.5)
                scale: (1, 1, 2)
        inputs:
            -
                position: (0, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.62
            -
                position: (0, 1, 0)
        outputs:
            -
                position: (0, 1, 1)
    logicCode: CondensedCablingBasicLogicComponents.Server.SuperDLatch
    clientCode: CondensedCablingBasicLogicComponents.Client.GenericSingleSliderSuperGate
    placingRules:
        offsetDimensions: (1, 2)
        gridPlacingDimensions: (1, 3)
        allowFineRotation: false

SuperRandomizer:
    column: "Logic"
    category: "SuperLogic"
    prefab:
        blocks:
            -
                color: F365AB
                scale: (1, 2, 1)
        inputs:
            -
                position: (0, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.62
        outputs:
            -
                position: (0, 1.5, 0.5)
                rotation: (90, 0, 0)
    logicCode: CondensedCablingBasicLogicComponents.Server.SuperRandomizer
    clientCode: CondensedCablingBasicLogicComponents.Client.GenericSingleSliderSuperGate
    placingRules:
        gridPlacingDimensions: (1, 3)

SuperRelay:
    column: "Logic"
    category: "SuperLogic"
    prefab:
        blocks:
            -
                color: 7E133B
                position: (0, 0, 0.5)
                scale: (1, 1, 2)
        inputs:
            -
                position: (0, 1, 0.5)
            -
                position: (0, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.62
            -
                position: (0, 0.5, 1.5)
                rotation: (90, 0, 0)
                length: 0.62
    logicCode: CondensedCablingBasicLogicComponents.Server.SuperRelay
    clientCode: CondensedCablingBasicLogicComponents.Client.GenericSingleSliderSuperGate
    placingRules:
        offsetDimensions: (1, 2)
        gridPlacingDimensions: (1, 4)
        allowFineRotation: false
        
SuperBuffer:
    column: "Logic"
    category: "SuperLogic"
    prefab:
        blocks:
            -
                mesh: BufferBody
        inputs:
            -
                position: (0, 1.15, -0.5)
                rotation: (-90, 0, 0)
                length: 0.5
        outputs:
            -
                position: (0, 0.4, 0.5)
                rotation: (90, 0, 0)
    logicCode: CondensedCablingBasicLogicComponents.Server.SuperBuffer
    clientCode: CondensedCablingBasicLogicComponents.Client.GenericSingleSliderSuperGate
    placingRules: Standard
    
SuperMixer:
    column: "Logic"
    category: "SuperLogic"
    prefab:
        blocks:
            -
                color: BAAE89
                scale: (7/4, 1, 1)
                position: (5/8, 0, 0)
            -
                color: BAAE89
                scale: (1, 1/3, 1/4)
                position: (-3/8, 1/2, 0)
                rotation: (0, -90, 0)
                mesh: BufferBody
            -
                color: BAAE89
                scale: (1, 1/3, 1/4)
                position: (-3/8, 1/2, 0)
                rotation: (0, -90, 180)
                mesh: BufferBody
        inputs:
            -
                position: (1, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.62
            -
                position: (0, 0.5, -0.5)
                rotation: (-90, 0, 0)
                length: 0.62
            -
                position: (0, 0.5, 0.5)
                rotation: (90, 0, 0)
                length: 0.62
            -
                position: (1, 0.5, 0.5)
                rotation: (90, 0, 0)
                length: 0.62
    logicCode: CondensedCablingBasicLogicComponents.Server.SuperMixer
    clientCode: CondensedCablingBasicLogicComponents.Client.GenericDoubleSliderSuperGate
    placingRules:
        offsetDimensions: (2, 1)
        allowFineRotation: false
        GridPositionsAreRelative: true