BoardPeg:
    column: "Miscellaneous"
    category: "Structural"
    clientCode: MorePegs.Client.BoardPeg
    logicCode: MorePegs.LogicCode.BoardPeg
    prefabGenerator: MorePegs.Client.BoardPegPrefabGenerator
    placingRules:
        secondaryGridPositions:
            - (1/6, 1/6)
            - (1/6, 3/6)
            - (1/6, 5/6)
            - (3/6, 1/6)
            - (3/6, 3/6)
            - (3/6, 5/6)
            - (5/6, 1/6)
            - (5/6, 3/6)
            - (5/6, 5/6)
        primaryEdgePositions:
            - (1/2, 0)
        secondaryEdgePositions:
            - (1/6, 0)
            - (3/6, 0)
            - (5/6, 0)
        canBeFlipped: false
        allowFineRotation: false
    codeInfoFloats:
        # Block Width
        - 1/3

        # Block Height
        - 0.1
        
        # Peg Height
        - 0.15

        # Rect Size
        - 1/12

    codeInfoBools:
        # X axis
        - true

        # Y axis
        - false
        
    codeInfoInts:
        # Pegs
        - 1
