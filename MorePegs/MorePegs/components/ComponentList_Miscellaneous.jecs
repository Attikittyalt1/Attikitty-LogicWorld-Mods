BoardPeg:
    column: "Miscellaneous"
    category: "Routing"
    logicCode: MorePegs.LogicCode.BoardPegSideOrTop
    prefab:
        blocks:
            -   
                position: (0, 0, 0)
                scale: (1/3, 0.1, 1/3)
        inputs:
            -
                length: 0.15
                position: (0, 0.1, 0)
    placingRules:
        secondaryGridPositions:
            - (1/6, 1/6)
            - (1/6, 3/6)
            - (1/6, 5/6)
            - (3/6, 1/6)
            - (3/6, 3/6)
            - (3/6, 5/6)
            - (5/6, 1/6)
            - (5/6, 3/6)
            - (5/6, 5/6)
        primaryEdgePositions:
            - (1/2, 0)
        secondaryEdgePositions:
            - (1/6, 0)
            - (3/6, 0)
            - (5/6, 0)
        canBeFlipped: false
        allowFineRotation: false

BoardPegWalled:
    column: "Miscellaneous"
    category: "Routing"
    logicCode: MorePegs.LogicCode.BoardPegWalled
    prefab:
        blocks:
            -   
                position: (0, 0, 0)
                scale: (1/3, 0.1, 1/3)

            -   
                position: (5/24, 0, 0)
                scale: (1/12, 0.13, 1/3)

            -   
                position: (-5/24, 0, 0)
                scale: (1/12, 0.13, 1/3)
        inputs:
            -
                length: 0.15
                position: (0, 0.1, 0)
    placingRules:
        secondaryGridPositions:
            - (1/6, 1/6)
            - (1/6, 3/6)
            - (1/6, 5/6)
            - (3/6, 1/6)
            - (3/6, 3/6)
            - (3/6, 5/6)
            - (5/6, 1/6)
            - (5/6, 3/6)
            - (5/6, 5/6)
        primaryEdgePositions:
            - (1/2, 0)
        secondaryEdgePositions:
            - (1/6, 0)
            - (3/6, 0)
            - (5/6, 0)
        canBeFlipped: false
        allowFineRotation: false

MultiPeg8:
    column: "Miscellaneous"
    category: "Structural"
    logicCode: MorePegs.LogicCode.BoardPegSideOrTop
    prefabGenerator: MorePegs.Client.MultiPegPrefabGenerator
    placingRules:
        secondaryGridPositions:
            - (1/6, 1/6)
            - (1/6, 3/6)
            - (1/6, 5/6)
            - (3/6, 1/6)
            - (3/6, 3/6)
            - (3/6, 5/6)
            - (5/6, 1/6)
            - (5/6, 3/6)
            - (5/6, 5/6)
        primaryEdgePositions:
            - (1/2, 0)
        secondaryEdgePositions:
            - (1/6, 0)
            - (3/6, 0)
            - (5/6, 0)
        canBeFlipped: false
        allowFineRotation: false
    codeInfoInts:
        # Pegs
        - 2

    codeInfoFloats:
        # Block Width
        - 1/3

        # Block Height
        - 0.1
        
        # Peg Height
        - 0.15
        